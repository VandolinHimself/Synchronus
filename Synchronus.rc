#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,7,0,0
 PRODUCTVERSION 2,7,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Lucius & Wayne Systems"
            VALUE "FileDescription", "Synchronus"
            VALUE "FileVersion", "2.7.0"
            VALUE "InternalName", "Synchronus"
            VALUE "OriginalFilename", "Synchronus.exe"
            VALUE "ProductName", "Synchronus"
            VALUE "ProductVersion", "2.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

101 ICON "mark.ico"
LOGO_PNG RCDATA "logo.png"
MARK_PNG RCDATA "mark.png"
BRAND_PNG RCDATA "brand.png"
FONT_PHILOSOPHER RCDATA "fonts\\Philosopher-Regular.ttf"
FONT_PHILOSOPHER_BOLD RCDATA "fonts\\Philosopher-Bold.ttf"
FONT_BRUNO RCDATA "fonts\\BrunoAceSC-Regular.ttf"
FONT_GRUPPO RCDATA "fonts\\Gruppo-Regular.ttf"

100 DIALOGEX 0, 0, 268, 92
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Synchronus"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Synchronus can start with Windows and stay in the system tray, so it keeps working after you close this window.", 100, 10, 8, 248, 32
    CONTROL "Start with Windows, minimized to the system tray", 1001, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 46, 248, 12
    DEFPUSHBUTTON "OK", IDOK, 160, 70, 44, 14
    PUSHBUTTON "Cancel", IDCANCEL, 210, 70, 48, 14
END
