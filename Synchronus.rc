#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,12,7,0
 PRODUCTVERSION 1,12,7,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Lucius And Wayne Systems LLC"
            VALUE "FileDescription", "Synchronus"
            VALUE "FileVersion", "1.12.7"
            VALUE "InternalName", "Synchronus"
            VALUE "OriginalFilename", "Synchronus.exe"
            VALUE "ProductName", "Synchronus"
            VALUE "ProductVersion", "1.12.7"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

